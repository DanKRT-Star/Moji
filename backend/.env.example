# Cổng server backend lắng nghe
PORT=5001

# URL của frontend - dùng cho CORS (Express + Socket.IO)
CLIENT_URL=http://localhost:5173

# Connection string MongoDB Atlas
MONGODB_CONNECTIONSTRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>

# Secret dùng để ký JWT access token
ACCESS_TOKEN_SECRET=your_jwt_access_secret

# Thông tin Cloudinary - dùng cho upload avatar và ảnh chat
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret